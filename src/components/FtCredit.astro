  </svg>
</a>
<style>
  .ftc {
    display: inline-flex; align-items: center; gap: .5em;
    text-decoration: none; color: inherit; opacity: .72;
    transition: opacity .15s ease;
  }
  .ftc:hover, .ftc:focus-visible { opacity: 1; }
  .ftc__by { font-size: .82em; letter-spacing: .02em; }
  .ftc__logo { width: 82px; height: auto; display: block; }
  .ftc__logo .g { fill: currentColor; }
  .ftc__logo .r { fill: var(--ftc-mark, #be3e29); }
</style>
