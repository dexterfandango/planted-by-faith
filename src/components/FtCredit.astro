      <path class="g" d="M1423.3 860 1196.28 500.32 1238.83 860H997.41L931.832 684.668H447.426L424.059 613.164H612.574L416.855 118.508h192.356l150.926 411.918h114L810.582 360.508c36.816-13.938 63.113-49.461 63.113-91.106 0-.254-.035-.507-.035-.769h52.254L1094.7 719.906 1041.34 268.633h135.08l284.82 451.273-168.77-451.273h149.69L1663.36 860H1423.3"/>
