---
// "Site by FT Media" footer credit. Drop this component into a client site's
// footer. Master copy lives in the ft-media repo; copies in the client repos
// should be updated from here.
//
// Tinting: the wordmark uses currentColor, so it picks up the footer's text
// color. Override --ftc-mark to change the rust block if it clashes.
---
<a class="ftc" href="https://ftmediaweb.com/" target="_blank" rel="noopener">
  <span class="ftc__by">Site by</span>
  <svg class="ftc__logo" viewBox="5 14 470 108" role="img" aria-label="FT Media">
    <g transform="matrix(0.133333,0,0,-0.133333,0,133.333)">
      <path class="r" d="m3362.65 268.719h-372.21v473.047h546.23l-174.02-473.047"/>
