---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <section class="wrap notfound">
    <h1>Page not found</h1>
    <p>Sorry, that page isn't here.</p>
    <p><a class="button" href="/">Go to the home page</a></p>
  </section>
</Base>
<style>
  .notfound { max-width: var(--measure); text-align: center; padding-block: 4rem 2rem; }
</style>
